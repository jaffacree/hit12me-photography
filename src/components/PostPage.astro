---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.astro';
import { sections } from '../site.config';
import { type Post, postUrl, postPhotos, postCover, formatDate, readingMinutes, getPosts } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
const { Content } = await render(post);
const section = sections[post.collection];
const photos = postPhotos(post);
const cover = postCover(post);
const og = cover ? await getImage({ src: cover.image, width: 1200, format: 'jpg', quality: 82 }) : undefined;

const siblings = await getPosts(post.collection);
const i = siblings.findIndex((p) => p.id === post.id);
const newer = siblings[i - 1];
const older = siblings[i + 1];
---
<Base title={post.data.title} description={post.data.summary} image={og?.src} transparentHeader={!!cover}>
  <header class:list={['hero', { 'no-cover': !cover }]}>
    {cover && (
      <Image src={cover.image} alt="" class="hero-img" widths={[800, 1400, 2000, 2800]} sizes="100vw" quality={85} loading="eager" fetchpriority="high" />
    )}
    <div class="wrap hero-text">
      <a class="eyebrow back" href={section.path}>{section.label}</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post)} min read</span>
        {photos.length > 0 && <><span aria-hidden="true">·</span><a href="#photos">{photos.length} photos</a></>}
      </p>
    </div>
  </header>

  <article class="wrap article">
    {post.data.summary && <p class="lede">{post.data.summary}</p>}
    <div class="prose"><Content /></div>

    {post.data.gear.length > 0 && (
      <aside class="gear" aria-label="Equipment used">
        <h2 class="eyebrow">In the bag</h2>
        <ul>{post.data.gear.map((g) => <li>{g}</li>)}</ul>
      </aside>
    )}
  </article>

  {photos.length > 0 && (
    <div id="photos" class="wrap photos">
      <Gallery photos={photos} title={post.data.title} />
    </div>
  )}

  <nav class="wrap pager" aria-label="More stories">
    {older ? <a href={postUrl(older)} class="older"><span class="muted">← Previous</span><strong>{older.data.title}</strong></a> : <span />}
    {newer ? <a href={postUrl(newer)} class="newer"><span class="muted">Next →</span><strong>{newer.data.title}</strong></a> : <span />}
  </nav>
</Base>

<style>
  .hero { position: relative; min-height: min(88vh, 900px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .hero :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: settle 2.4s cubic-bezier(.2,.7,.2,1) both; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(6,19,40,.92) 0%, rgba(6,19,40,.35) 45%, rgba(6,19,40,.1) 75%); }
  .hero.no-cover { min-height: 0; padding-top: 64px; color: var(--text); }
  .hero.no-cover::after { display: none; }
  .hero-text { position: relative; z-index: 1; padding-block: 48px clamp(40px, 7vw, 80px); }
  .back { text-decoration: none; display: inline-block; margin-bottom: 18px; }
  h1 { font-size: clamp(38px, 6.4vw, 84px); max-width: 18ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0 0; font-size: 15px; color: color-mix(in srgb, currentColor 78%, transparent); }
  .meta a { text-decoration: none; border-bottom: 1px solid currentColor; }
  @keyframes settle { from { transform: scale(1.06); opacity: .6; } to { transform: none; opacity: 1; } }

  .article { max-width: calc(var(--measure) + 2 * var(--gutter)); padding-block: clamp(48px, 7vw, 88px) 24px; }
  .lede { font: 500 clamp(20px, 2.2vw, 24px)/1.55 var(--font-display); color: var(--text); margin-bottom: 1.6em; }
  .prose { font-size: 18px; line-height: 1.8; color: color-mix(in srgb, var(--text) 92%, transparent); }
  .prose :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .prose :global(p:first-child::first-letter) { float: left; font: 800 3.6em/0.85 var(--font-display); padding: .08em .1em 0 0; color: var(--accent); }

  .gear { margin-top: 48px; padding: 24px 26px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .gear h2 { margin-bottom: 14px; }
  .gear ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .gear li { background: var(--surface-2); border: 1px solid var(--line); padding: 6px 12px; border-radius: 99px; font-size: 14px; }

  .photos { padding-top: 40px; max-width: 1600px; scroll-margin-top: 80px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-block: 72px 24px; }
  .pager a { display: flex; flex-direction: column; gap: 6px; padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; transition: border-color .2s, background .2s; }
  .pager a:hover { border-color: var(--accent); background: var(--surface); }
  .pager strong { font: 600 18px/1.35 var(--font-display); }
  .newer { text-align: right; }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } .newer { text-align: left; } }
</style>
