---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import { sections, type SectionKey } from '../site.config';
import { getPosts } from '../lib/posts';
interface Props { section: SectionKey }
const s = sections[Astro.props.section];
const posts = await getPosts(Astro.props.section);
const [first, ...rest] = posts;
---
<Base title={s.title} description={s.blurb}>
  <section class="wrap intro">
    <p class="eyebrow">{posts.length} stories</p>
    <h1>{s.title}</h1>
    <p class="muted">{s.blurb}</p>
  </section>
  <section class="wrap list">
    {first && <div class="lead"><PostCard post={first} large /></div>}
    <div class="grid">{rest.map((p) => <PostCard post={p} />)}</div>
  </section>
</Base>
<style>
  .intro { padding-block: clamp(56px, 9vw, 110px) clamp(32px, 5vw, 56px); }
  .intro h1 { font-size: clamp(48px, 8vw, 104px); margin: 14px 0 18px; }
  .intro p.muted { font-size: 19px; max-width: 52ch; margin: 0; }
  .lead { margin-bottom: clamp(36px, 5vw, 64px); }
  .lead :global(.card .link) { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(20px, 3vw, 44px); align-items: center; }
  .lead :global(.card .media) { aspect-ratio: 16 / 10; }
  @media (max-width: 860px) { .lead :global(.card .link) { grid-template-columns: 1fr; } }
</style>
