---
import { Image } from 'astro:assets';
import { sections } from '../site.config';
import { type Post, postUrl, postCover, formatDate } from '../lib/posts';
interface Props { post: Post; showSection?: boolean; large?: boolean }
const { post, showSection = false, large = false } = Astro.props;
const cover = postCover(post);
---
<article class:list={['card reveal', { large }]}>
  <a href={postUrl(post)} class="link">
    <div class="media">
      {cover ? (
        <Image src={cover.image} alt={post.data.title} widths={[480, 800, 1200]} sizes={large ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 760px) 100vw, 420px'} quality={80} />
      ) : (
        <div class="placeholder" aria-hidden="true"><span>{post.data.title.charAt(0)}</span></div>
      )}
      {post.data.draft && <span class="draft">Draft</span>}
    </div>
    <div class="body">
      <p class="meta">
        {showSection && <span class="eyebrow">{sections[post.collection].label}</span>}
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
      <h3>{post.data.title}</h3>
      {post.data.summary && <p class="summary">{post.data.summary}</p>}
    </div>
  </a>
</article>

<style>
  .card { min-width: 0; }
  .link { display: block; text-decoration: none; }
  .media { position: relative; aspect-ratio: 3 / 2; border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1), filter .4s; }
  .link:hover .media :global(img) { transform: scale(1.045); }
  .placeholder { width: 100%; height: 100%; display: grid; place-items: center; background: radial-gradient(120% 120% at 20% 10%, var(--surface-2), var(--surface) 60%); }
  .placeholder span { font: 800 72px/1 var(--font-display); color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .draft { position: absolute; top: 12px; left: 12px; background: var(--accent); color: var(--accent-ink); font: 600 12px/1 var(--font-body); padding: 6px 10px; border-radius: 99px; }
  .body { padding: 18px 2px 0; }
  .meta { display: flex; gap: 14px; align-items: center; margin: 0 0 8px; font-size: 14px; color: var(--muted); }
  h3 { font-size: 21px; line-height: 1.25; transition: color .2s; }
  .large h3 { font-size: clamp(26px, 3vw, 36px); }
  .link:hover h3 { color: var(--accent); }
  .summary { margin: 10px 0 0; color: var(--muted); font-size: 15.5px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
