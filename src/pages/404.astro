---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>Out of frame.</h1>
    <p class="muted">That page doesn't exist — it may have moved when the site was rebuilt.</p>
    <a class="btn" href="/">Back to home</a>
  </section>
</Base>
<style>
  .nf { padding-block: clamp(80px, 14vw, 180px); text-align: center; }
  h1 { font-size: clamp(48px, 8vw, 96px); margin: 14px 0 18px; }
  .muted { margin-bottom: 30px; }
</style>
